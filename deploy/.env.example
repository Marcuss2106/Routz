# Copy to deploy/.env on a Vultr VM. Do not commit the real file.
INTERNAL_API_TOKEN=replace-with-a-long-random-shared-token
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Tiger Data/Timescale connection string, for example:
# TIGERDATA_DATABASE_URL=postgresql://user:password@host:5432/routz
TIGERDATA_DATABASE_URL=
# Public HTTPS origins of the user-facing map (comma-separated).
# e.g. USER_ALLOWED_ORIGINS=http://localhost:3000,https://routz.vercel.app
USER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
# Rail state and simulated microphone ingestion are public demo transports.
# Wildcard is deliberate: an Origin allowlist is not authentication, and
# Vercel preview URLs otherwise break every time their hostname changes.
DEPLOYED_SIMULATION_ALLOWED_ORIGINS=*
# Public DNS names terminated by the Caddy service in docker-compose.yml.
# Create one DuckDNS A record per name pointing at the VM IP first, otherwise
# Caddy cannot issue certificates and wss:// will fail exactly like
# "Firefox can't establish a connection to wss://routz-rail.duckdns.org/...".
# Three names are required because rail :8000 and acoustic :8001 both serve
# /ws/simulation and cannot share one host.
RAIL_DOMAIN=routz-rail.duckdns.org
USER_DOMAIN=routz-user.duckdns.org
ACOUSTIC_DOMAIN=routz-acoustic.duckdns.org
